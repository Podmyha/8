def is_prime(num):
    number = int(num)
    if num  <= 1:
        return False
    for i in range(2, int(num**0.5)+1):
        if num % i == 0:
            return False
def get_prime(num):
    next = num + 1
    while True:
        if is_prime(next):
            return next
        next += 1
print(is_prime(1))
print(is_prime(10))
print(is_prime(17))
