import random

vspisok = [[random.randint(10, 99) for i in range(5)] for i in range(3)]

print("Исходный вложенный список:")
print(vspisok)

max_value  = vspisok[0][0]
max_row = 0
max_col = 0
for i in range(3):
    for j in range(5):
        if vspisok[i][j] > max_value:
            max_value = vspisok[i][j]
            max_row = i
            max_col = j
print(f"Максимальный элемент {max_value} на позиции [{max_row},{max_col}]")
